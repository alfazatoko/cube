rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global: licenses & freeTrials (publik, untuk pre-login) ──
    match /licenses/{docId} {
      allow read, write: if true;
    }
    match /freeTrials/{docId} {
      allow read, write: if true;
    }

    // ── Settings Global (main) ──
    match /settings/main {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── SUBCOLLECTION ARCHITECTURE (seperti akun bank) ──
    // Setiap user memiliki foldernya sendiri di /users/{userId}/...
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Fallback ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
