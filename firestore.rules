rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global: licenses & freeTrials (publik, untuk pre-login) ──
    match /licenses/{docId} {
      allow read, write: if true;
    }
    match /freeTrials/{docId} {
      allow read, write: if true;
    }

    // ── Settings: pre-login global (main), per-user (uid) ──
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && (docId == "main" || request.auth.uid == docId);
    }

    // ── Transactions: buat hanya jika uid cocok ──
    match /transactions/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    // ── Koleksi flat lainnya: semua pakai field uid ──
    match /saldo_history/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /balances/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /kasirs/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /hutang/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /kontak/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /attendance/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /izin/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /daily_notes/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    match /daily_snapshots/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    // ── Fallback: koleksi lain butuh login ──
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
