rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Koleksi global untuk Lisensi (Akses Publik via Panel Admin)
    match /licenses/{docId} {
      allow read, write: if true;
    }

    // Koleksi global untuk Sistem (Akses Publik via Panel Admin)
    match /system/{docId} {
      allow read, write: if true;
    }

    // Data utama per Email (Tenant Isolation)
    // Semua koleksi (transactions, balances, kasirs, settings, dll)
    // otomatis aman karena terkunci di dalam brankas ini
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
  }
}
